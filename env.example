# Copy to .env (never commit .env). Values shown are placeholders.

# Transport: stdio (default, for local MCP clients) or http (for hosted deployments)
QUANT_MCP_TRANSPORT=stdio

# Optional comma-separated Host allow-list; setting it enables DNS-rebinding protection
QUANT_MCP_ALLOWED_HOSTS=

# Maximum request body in bytes (default 1048576)
QUANT_MCP_MAX_BODY_BYTES=1048576

# Logging: DEBUG, INFO, WARNING, ERROR
QUANT_MCP_LOG_LEVEL=WARNING

# Host and port for http transport when run with uvicorn via `quant-mcp`
QUANT_MCP_HOST=127.0.0.1
QUANT_MCP_PORT=8000

# Bearer token required on /mcp (Authorization: Bearer <token>). Required for http transport.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"  (minimum 32 characters)
QUANT_MCP_API_TOKEN=

# Set to 1 only if the /mcp URL is protected some other way. Otherwise /mcp fails closed without a token.
QUANT_MCP_ALLOW_ANONYMOUS=

# Per-client request limit on /mcp per minute (per instance). 0 disables.
QUANT_MCP_RATE_LIMIT_PER_MINUTE=60

# Market-data providers the server may call. Default is yahoo only.
# Add alphavantage only if you have access control in front of the endpoint: it spends your API quota.
QUANT_MCP_ENABLED_PROVIDERS=yahoo

# Optional: Alpha Vantage key, used only when alphavantage is enabled
ALPHAVANTAGE_API_KEY=
